rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == "wumeihui.lily@gmail.com";
    }

    function validLearnerCheckIn(attendanceId, sessionId, sessionTitle) {
      return signedIn()
        && attendanceId == sessionId + "_" + request.auth.uid
        && request.resource.data.keys().hasOnly([
          "uid", "email", "name", "sessionId", "sessionTitle",
          "points", "checkInCode", "checkedInAt"
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.sessionId == sessionId
        && request.resource.data.sessionTitle == sessionTitle
        && request.resource.data.points == 2
        && request.resource.data.checkInCode == get(/databases/$(database)/documents/checkins/$(sessionId)).data.code
        && get(/databases/$(database)/documents/checkins/$(sessionId)).data.checkInOpen == true
        && get(/databases/$(database)/documents/checkins/$(sessionId)).data.expiresAt > request.time
        && request.resource.data.checkedInAt == request.time;
    }

    match /academyConfig/{configId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /members/{memberId} {
      allow get: if signedIn() && (memberId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn()
        && memberId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "uid", "email", "name", "photoURL", "role", "joinedAt", "lastSeenAt"
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && (request.resource.data.role == "student" || isAdmin());
      allow update: if signedIn()
        && memberId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "uid", "email", "name", "photoURL", "role", "joinedAt", "lastSeenAt"
        ])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role;
      allow delete: if isAdmin();
    }

    match /sessions/{sessionId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Active codes are intentionally separated from learner-readable session metadata.
    match /checkins/{sessionId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow get: if signedIn()
        && (attendanceId == "session01_" + request.auth.uid
          || attendanceId == "session02_" + request.auth.uid
          || resource.data.uid == request.auth.uid
          || isAdmin());
      allow list: if signedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());

      allow create: if isAdmin()
        || validLearnerCheckIn(attendanceId, "session01", "Fall 2026 Intro Meeting")
        || validLearnerCheckIn(attendanceId, "session02", "Where Signals Come From");

      allow update, delete: if isAdmin();
    }
  }
}
